---
import Icon from '../components/Icon.astro'
import workspace from '../assets/workspace.png'
import '../styles/global.css'
import rootPackage from '../../../../package.json'
import { releaseDownloads } from '../lib/downloads'

const repository = 'https://github.com/nassimna/ternline'
const version = import.meta.env.WEBSITE_RELEASE_VERSION ?? rootPackage.version
const release = `${repository}/releases/tag/v${version}`
const downloads = releaseDownloads(version)
const documentation = `${repository}/blob/main`
const publicPath = import.meta.env.BASE_URL.replace(/\/$/, '')
const favicon = `${publicPath}/favicon.svg`
const publicKey = `${publicPath}/ternline.pub`
const canonical = 'https://ternline.com/'
const shareImage = new URL(`${publicPath}/social-preview.png`, Astro.site).href
const hasSignatures = process.env.RELEASE_SIGNATURES_AVAILABLE === 'true'
const description =
  'Ternline is a desktop workspace for local and SSH terminals, browser previews, and CLI automation. Linux, macOS, and Windows. Free and open source; currently in alpha.'
const screenshotDescription =
  'Ternline in dark mode with fictional Atlas Web, API Service, Design System, and Release Tools workspaces selected in blue, green, purple, and amber, alongside development and workspace CLI terminals.'

const facts = [
  { icon: 'remote', label: 'Saved SSH connections' },
  { icon: 'terminal', label: 'tmux sessions' },
  { icon: 'code', label: 'Workspace CLI' },
  { icon: 'code', label: 'GPL-3.0-or-later' }
] as const

const features = [
  {
    icon: 'remote',
    title: 'Your SSH sessions, organized.',
    description:
      "Save connections, discover tmux sessions, and reconnect to remote work. Split terminals around the task and detach when you're done."
  },
  {
    icon: 'code',
    title: 'A CLI for the tools you choose.',
    description:
      'Let scripts or an agent app with shell access create workspaces, send terminal input, and inspect the browser. The work stays visible here.'
  },
  {
    icon: 'document',
    title: 'Keep the context close.',
    description:
      'Keep local browser previews, files, diffs, and editable notes beside your terminals. Give each project room for the whole task.'
  }
] as const

const sessions = [
  { icon: 'remote', label: 'SSH / build-box', caption: 'Remote terminal' },
  { icon: 'terminal', label: 'storefront / pnpm dev', caption: 'Local task' },
  { icon: 'browser', label: 'Browser / localhost:3000', caption: 'Local preview' }
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d15" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ternline — Local or remote. One place to work." />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta
      property="og:image:alt"
      content="Ternline — local and SSH terminals, browser previews, and CLI automation."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ternline — Local or remote. One place to work." />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>Ternline — Local or remote. One place to work.</title>
  </head>
  <body id="top" class="font-sans text-ink antialiased">
    <a
      href="#main"
      class="fixed top-4 left-4 z-50 -translate-y-24 rounded bg-ink px-4 py-3 text-sm text-canvas focus:translate-y-0"
    >
      Skip to content
    </a>
    <div class="mx-auto max-w-[1160px] px-[22px] sm:px-[34px]">
      <header>
        <nav
          aria-label="Main navigation"
          class="flex min-h-[90px] flex-wrap items-center justify-between gap-x-5 gap-y-2 py-4"
        >
          <a
            href="#top"
            class="flex items-center gap-2.5 text-[21px] font-semibold tracking-[-0.8px]"
          >
            <img src={favicon} width="32" height="32" alt="" />
            Ternline
          </a>
          <div class="flex items-center gap-4 text-xs text-muted sm:gap-[27px]">
            <a href="#ssh" class="py-2 transition-colors hover:text-ink">
              SSH
            </a>
            <a href="#cli" class="py-2 transition-colors hover:text-ink">
              CLI
            </a>
            <a
              href={repository}
              class="inline-flex min-h-10 items-center gap-2 rounded-[5px] border border-line px-3 text-ink transition-colors hover:border-accent/50 sm:px-3.5"
            >
              <Icon name="github" class="size-3.5" />
              <span class="max-[360px]:sr-only">Source</span>
            </a>
          </div>
        </nav>
      </header>

      <main id="main">
        <section aria-labelledby="hero-title" class="pt-[34px] pb-[42px] text-center sm:pt-[53px]">
          <p class="eyebrow flex items-center justify-center gap-2.5 text-[10px]">
            <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
            SSH workspaces. CLI control.
          </p>
          <h1
            id="hero-title"
            class="mt-[25px] text-[clamp(40px,5.6vw,73px)] leading-[1.05] font-medium tracking-[-2px] sm:tracking-[-3.7px]"
          >
            Local or remote.
            <br />
            <span class="text-accent">One place to work.</span>
          </h1>
          <p class="mx-auto mt-[23px] mb-[25px] max-w-[455px] text-sm leading-[1.65] text-[#b0afc1]">
            Connect your servers. Keep terminals, previews, and context together.
            <br />
            Let your shell or agent app drive the workspace through the CLI.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              id="recommended-download"
              href="#downloads"
              class="button bg-accent text-[#15121e] hover:bg-[#c2b4ff]"
            >
              <span id="download-label">Download Ternline</span>
              <Icon name="download" class="size-4" />
            </a>
            <a
              href="#ssh"
              class="button border-line text-ink hover:border-accent/50 hover:bg-white/5"
            >
              Explore SSH workspaces
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
          <p class="mt-[15px] text-[11px] text-muted">Alpha · Cross-platform · Open source</p>
          <figure class="relative mx-auto mt-10 max-w-[980px]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -inset-[7px] rounded-[15px] border border-accent/15"
            ></div>
            <img
              src={workspace.src}
              width={workspace.width}
              height={workspace.height}
              alt={screenshotDescription}
              fetchpriority="high"
              decoding="async"
              class="block h-auto w-full rounded-[9px] border border-[#30303e] shadow-[0_25px_65px_#0004]"
            />
            <figcaption class="mt-3 flex items-center justify-between gap-4 text-[11px] text-muted">
              <span>Real app · four colored workspaces</span>
              <button
                type="button"
                id="open-screenshot"
                aria-haspopup="dialog"
                aria-controls="workspace-screenshot"
                class="shrink-0 py-1 underline underline-offset-4 hover:text-ink"
              >
                View full size
              </button>
            </figcaption>
          </figure>
        </section>

        <ul class="grid grid-cols-2 gap-x-3 gap-y-5 border-y border-line py-6 sm:grid-cols-4">
          {facts.map(({ icon, label }) => (
            <li class="flex items-center gap-2.5 text-[11px] text-[#b8b6c8] sm:justify-center">
              <Icon name={icon} class="size-4 shrink-0 text-accent" />
              {label}
            </li>
          ))}
        </ul>

        <section id="ssh" aria-labelledby="ssh-title" class="pt-[52px] pb-[42px] md:pt-[87px]">
          <div class="mb-9 flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-10">
            <div>
              <p class="eyebrow mb-[17px]">Your servers, within reach</p>
              <h2
                id="ssh-title"
                class="text-[clamp(33px,3.3vw,46px)] leading-[1.12] font-medium tracking-[-1.7px]"
              >
                Connect once.
                <br />
                Keep the work in view.
              </h2>
            </div>
            <p class="max-w-[380px] text-[13px] leading-[1.65] text-muted">
              Switch between local projects and SSH sessions in the same workspace. Keep the tools
              you already use in the loop.
            </p>
          </div>
          <div class="grid gap-0 md:grid-cols-3 md:gap-9">
            {features.map(({ icon, title, description }) => (
              <article class="min-w-0 border-t border-line py-[29px]">
                <Icon name={icon} class="mb-[22px] size-6 text-accent" />
                <h3 class="mb-2.5 text-base font-medium tracking-[-0.4px]">{title}</h3>
                <p class="max-w-[330px] text-[13px] leading-[1.65] text-muted">{description}</p>
              </article>
            ))}
          </div>
        </section>

        <section
          id="cli"
          aria-labelledby="cli-title"
          class="mt-[25px] grid overflow-hidden rounded-[9px] border border-line bg-[#171522] lg:grid-cols-2"
        >
          <div class="px-[26px] py-[30px] sm:p-[45px]">
            <p class="eyebrow mb-5">Keep your preferred agent app</p>
            <h2
              id="cli-title"
              class="text-[30px] leading-[1.14] font-medium tracking-[-1.3px] sm:text-[34px]"
            >
              Your tools call the CLI.
              <br />
              The work happens here.
            </h2>
            <p class="mt-[18px] mb-[25px] max-w-[340px] text-[13px] leading-[1.65] text-muted">
              Use the installed CLI from your shell, scripts, or an agent app that can run commands
              on your machine. Control terminals, SSH sessions, and local browser panes while
              Ternline is running.
            </p>
            <a
              href={`${documentation}/docs/CLI.md`}
              class="inline-flex items-center gap-2 py-2 text-xs text-muted hover:text-ink"
            >
              Explore the CLI
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
          <figure class="flex items-center justify-center bg-linear-to-br from-[#201b3066] to-[#14121c] p-[26px] sm:p-[35px]">
            <div class="w-full max-w-[330px]">
              <div class="flex items-center gap-2.5 rounded-[5px] border border-[#8e7caf88] bg-[#2a233a] px-4 py-[13px] text-xs">
                <Icon name="code" class="size-4 shrink-0 text-accent" />
                Your agent app · Your shell
              </div>
              <div class="mt-3 flex items-center gap-2.5 rounded-[5px] border border-[#8e7caf88] bg-[#2a233a] px-4 py-[13px] text-xs">
                <Icon name="terminal" class="size-4 shrink-0 text-accent" />
                Workspace CLI → Ternline
              </div>
              <ul class="ml-6 border-l border-[#595065] pl-6">
                {sessions.map(({ icon, label, caption }) => (
                  <li class="session-node relative mt-[15px] flex items-center gap-3 rounded border border-[#36303f] bg-[#1b1725] p-[13px]">
                    <Icon name={icon} class="size-4 shrink-0 text-accent" />
                    <div class="min-w-0 text-[11px]">
                      <p>{label}</p>
                      <p class="mt-1 text-[10px] text-[#b6b0c5]">{caption}</p>
                    </div>
                  </li>
                ))}
              </ul>
              <figcaption class="mt-5 text-center text-[10px] text-muted">
                Conceptual workflow
              </figcaption>
            </div>
          </figure>
        </section>

        <section
          id="downloads"
          aria-labelledby="downloads-title"
          class="pt-[65px] pb-6 md:pt-[90px]"
        >
          <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="eyebrow mb-4">Start your next workspace</p>
              <h2
                id="downloads-title"
                class="text-[clamp(33px,3.3vw,46px)] leading-[1.12] font-medium tracking-[-1.7px]"
              >
                Download Ternline.
              </h2>
            </div>
            <div class="text-[13px] leading-relaxed text-muted">
              <a
                id="download-release"
                data-version={version}
                href={release}
                class="text-accent underline underline-offset-4"
              >
                v{version} · {version.includes('-') ? 'Pre-release' : 'Release'}
              </a>
              <p id="download-suggestion" aria-live="polite">
                Choose your operating system below.
              </p>
            </div>
          </div>
          <div class="grid gap-4 md:grid-cols-3">
            <article
              id="download-mac"
              class="min-w-0 rounded-md border border-line bg-white/[0.025] p-6"
            >
              <h3 class="text-xl font-medium">macOS</h3>
              <p class="mt-2 mb-6 text-xs leading-relaxed text-muted">
                Choose the chip in your Mac. This unsigned release requires approval in macOS on
                first launch.
              </p>
              <div class="flex flex-col gap-3 text-[13px]">
                <a
                  data-download="mac-arm64"
                  href={downloads['mac-arm64']}
                  class="inline-flex items-center justify-between gap-2 rounded border border-line px-3 py-3 hover:border-accent"
                >
                  Apple Silicon · DMG <Icon name="download" class="size-4 shrink-0" />
                </a>
                <a
                  data-download="mac-x64"
                  href={downloads['mac-x64']}
                  class="inline-flex items-center justify-between gap-2 rounded border border-line px-3 py-3 hover:border-accent"
                >
                  Intel · DMG <Icon name="download" class="size-4 shrink-0" />
                </a>
              </div>
            </article>
            <article
              id="download-windows"
              class="min-w-0 rounded-md border border-line bg-white/[0.025] p-6"
            >
              <h3 class="text-xl font-medium">Windows</h3>
              <p class="mt-2 mb-6 text-xs leading-relaxed text-muted">
                Per-user installer for x64 PCs. Windows may show a publisher warning.
              </p>
              <a
                data-download="windows-x64"
                href={downloads['windows-x64']}
                class="inline-flex w-full items-center justify-between gap-2 rounded border border-line px-3 py-3 text-[13px] hover:border-accent"
              >
                Windows x64 · EXE <Icon name="download" class="size-4 shrink-0" />
              </a>
            </article>
            <article
              id="download-linux"
              class="min-w-0 rounded-md border border-line bg-white/[0.025] p-6"
            >
              <h3 class="text-xl font-medium">Linux</h3>
              <p class="mt-2 mb-6 text-xs leading-relaxed text-muted">
                x86_64 desktop packages. OpenSSH is required; AppImage may need FUSE 2.
              </p>
              <a
                data-download="linux-x64"
                href={downloads['linux-x64']}
                class="inline-flex w-full items-center justify-between gap-2 rounded border border-line px-3 py-3 text-[13px] hover:border-accent"
              >
                Linux x64 · AppImage <Icon name="download" class="size-4 shrink-0" />
              </a>
              <div class="mt-4 flex flex-wrap gap-5 text-xs text-muted">
                <a
                  data-download="linux-deb"
                  href={downloads['linux-deb']}
                  class="underline underline-offset-4 hover:text-ink"
                >
                  Debian / Ubuntu
                </a>
                <a
                  data-download="linux-rpm"
                  href={downloads['linux-rpm']}
                  class="underline underline-offset-4 hover:text-ink"
                >
                  Fedora / RHEL
                </a>
                <a
                  href={`${documentation}/packaging/aur/README.md`}
                  class="underline underline-offset-4 hover:text-ink"
                >
                  Arch Linux
                </a>
              </div>
            </article>
          </div>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 text-xs leading-relaxed text-muted">
            <p>
              Alpha: no stable support guarantee; macOS and Windows installers lack platform code
              signing.{' '}
              <a
                href={`${documentation}/docs/INSTALLATION.md`}
                class="text-accent underline underline-offset-4"
              >
                Installation notes
              </a>
            </p>
            <div class="flex flex-wrap gap-5">
              <a
                data-download="checksums"
                href={downloads.checksums}
                class="underline underline-offset-4 hover:text-ink"
              >
                Checksums
              </a>
              <a
                href={publicKey}
                download="ternline.pub"
                class="underline underline-offset-4 hover:text-ink"
              >
                Public key
              </a>
              <a
                href={`${documentation}/README.md`}
                class="underline underline-offset-4 hover:text-ink"
              >
                Build from source
              </a>
            </div>
          </div>
          <details
            id="verify-downloads"
            class="group mt-5 rounded-md border border-line px-5 py-4 text-sm"
          >
            <summary class="flex list-none items-center justify-between gap-5 text-ink">
              Verify a download
              <span aria-hidden="true" class="text-lg text-muted group-open:hidden">
                +
              </span>
              <span aria-hidden="true" class="hidden text-lg text-muted group-open:block">
                −
              </span>
            </summary>
            {hasSignatures ? (
              <div class="mt-4 space-y-4 text-xs leading-relaxed text-muted">
                <p>
                  Optional: check that your installer was signed with Ternline’s release key and has
                  not changed. This does not remove macOS or Windows security warnings.
                </p>
                <ol class="list-decimal space-y-2 pl-5">
                  <li>
                    Download your installer and its matching <code>.sig</code> file from the{' '}
                    <a
                      data-release-files
                      href={release}
                      class="text-accent underline underline-offset-4"
                    >
                      release files
                    </a>
                    .
                  </li>
                  <li>
                    Download our{' '}
                    <a
                      href={publicKey}
                      download="ternline.pub"
                      class="text-accent underline underline-offset-4"
                    >
                      public key
                    </a>{' '}
                    and put all three files in the same folder.
                  </li>
                  <li>
                    Install{' '}
                    <a
                      href="https://jedisct1.github.io/minisign/"
                      class="text-accent underline underline-offset-4"
                    >
                      Minisign
                    </a>{' '}
                    and run this command, replacing <code>FILE</code> with your installer’s
                    filename.
                  </li>
                </ol>
                <pre class="overflow-x-auto rounded border border-line bg-[#15121e] p-3 text-ink"><code>minisign -Vm FILE -x FILE.sig -p ternline.pub</code></pre>
                <p>
                  Install only if verification succeeds. If it fails, do not run the installer. Keep
                  a trusted copy of the public key for future downloads. Signatures confirm the
                  file’s origin and integrity; they are not a malware scan.
                </p>
              </div>
            ) : (
              <p class="mt-4 text-xs leading-relaxed text-muted">
                This release does not include signature files. Use the checksums above to check your
                download for corruption. Signature verification will be available with future signed
                releases.
              </p>
            )}
          </details>
        </section>

        <section
          aria-labelledby="faq-title"
          class="grid gap-[22px] pt-[53px] pb-[60px] md:grid-cols-[1fr_1.4fr] md:gap-[70px] md:pt-[75px] md:pb-[90px]"
        >
          <div>
            <p class="eyebrow mb-[18px]">Before you jump in</p>
            <h2
              id="faq-title"
              class="text-[clamp(33px,3.3vw,46px)] leading-[1.12] font-medium tracking-[-1.7px]"
            >
              A few useful details.
            </h2>
          </div>
          <div>
            <details class="group border-b border-line">
              <summary class="flex list-none items-center justify-between gap-5 py-[19px] text-[13px] leading-[1.45]">
                What do I need for SSH workspaces?
                <span aria-hidden="true" class="text-lg text-muted group-open:hidden">
                  +
                </span>
                <span aria-hidden="true" class="hidden text-lg text-muted group-open:block">
                  −
                </span>
              </summary>
              <p class="pr-6 pb-[18px] text-[13px] leading-[1.65] text-muted">
                Managed SSH uses saved connections, SSH credentials, and explicit host trust. tmux
                session management requires tmux 3.2+ on the remote host. Remote browser routing and
                notification relay are not implemented;{' '}
                <a
                  href={`${documentation}/docs/KNOWN_LIMITATIONS.md`}
                  class="text-accent underline underline-offset-4"
                >
                  read the current boundaries
                </a>
                .
              </p>
            </details>
            <details class="group border-b border-line">
              <summary class="flex list-none items-center justify-between gap-5 py-[19px] text-[13px] leading-[1.45]">
                Does my agent have to run inside Ternline?
                <span aria-hidden="true" class="text-lg text-muted group-open:hidden">
                  +
                </span>
                <span aria-hidden="true" class="hidden text-lg text-muted group-open:block">
                  −
                </span>
              </summary>
              <p class="pr-6 pb-[18px] text-[13px] leading-[1.65] text-muted">
                No. Keep using your preferred app. If it can execute shell commands on the same
                machine, it can call the installed CLI while the desktop is running. Running an
                agent in a Ternline terminal is also an option.
              </p>
            </details>
            <details class="group border-b border-line">
              <summary class="flex list-none items-center justify-between gap-5 py-[19px] text-[13px] leading-[1.45]">
                Is there a ready-to-download release?
                <span aria-hidden="true" class="text-lg text-muted group-open:hidden">
                  +
                </span>
                <span aria-hidden="true" class="hidden text-lg text-muted group-open:block">
                  −
                </span>
              </summary>
              <p class="pr-6 pb-[18px] text-[13px] leading-[1.65] text-muted">
                Yes. Download the current pre-release for your operating system above. Ternline is
                cross-platform and currently alpha. Check the{' '}
                <a
                  href={`${documentation}/README.md`}
                  class="text-accent underline underline-offset-4"
                >
                  project documentation
                </a>{' '}
                for current build and release instructions.
              </p>
            </details>
          </div>
        </section>
      </main>

      <footer class="flex flex-wrap items-center justify-between gap-5 border-t border-line py-[30px] text-[11px] text-muted">
        <p>Ternline · Your servers and tools, in one place.</p>
        <nav aria-label="Footer navigation" class="flex gap-[22px]">
          <a href={repository} class="hover:text-ink">
            GitHub
          </a>
          <a href={`${documentation}/docs/FEATURES.md`} class="hover:text-ink">
            Docs
          </a>
          <a href={`${documentation}/LICENSE`} class="hover:text-ink">
            License
          </a>
        </nav>
      </footer>
    </div>

    <dialog
      id="workspace-screenshot"
      aria-labelledby="screenshot-title"
      class="m-auto max-h-[calc(100dvh-32px)] w-[calc(100%-32px)] max-w-[1480px] rounded-md border border-[#575a6b] bg-[#1c1d25] p-4 text-ink"
    >
      <div class="flex items-center justify-between gap-4">
        <h2 id="screenshot-title" class="text-base font-medium sm:text-xl">
          Inside Ternline
        </h2>
        <form method="dialog">
          <button
            autofocus
            class="min-h-10 rounded border border-[#575a6b] px-3 text-xs hover:bg-white/5"
          >
            Close
          </button>
        </form>
      </div>
      <div
        class="mt-4 max-h-[calc(100dvh-170px)] overflow-auto rounded"
        tabindex="0"
        aria-label="Full-size app screenshot; scroll to explore"
      >
        <img
          src={workspace.src}
          width={workspace.width}
          height={workspace.height}
          alt={screenshotDescription}
          loading="lazy"
          class="block h-auto max-w-none"
        />
      </div>
      <p class="mt-3 text-xs leading-relaxed text-muted">
        Real app · four colored workspaces · fictional projects
      </p>
    </dialog>

    <dialog
      id="macos-first-launch"
      aria-labelledby="macos-first-launch-title"
      aria-describedby="macos-first-launch-description"
      class="m-auto max-h-[calc(100dvh-32px)] w-[calc(100%-32px)] max-w-[560px] overflow-auto rounded-md border border-[#575a6b] bg-[#1c1d25] p-6 text-ink sm:p-8"
    >
      <div class="flex items-start justify-between gap-4">
        <h2 id="macos-first-launch-title" class="text-xl font-medium sm:text-2xl">
          Opening Ternline on macOS
        </h2>
        <form method="dialog">
          <button
            autofocus
            class="min-h-10 rounded border border-[#575a6b] px-3 text-xs hover:bg-white/5"
          >
            Close
          </button>
        </form>
      </div>
      <p id="macos-first-launch-description" class="mt-4 text-sm leading-relaxed text-muted">
        This release is unsigned and not notarized by Apple. If you trust this download, you can
        approve Ternline when macOS blocks its first launch.
      </p>
      <ol class="mt-5 list-decimal space-y-3 pl-5 text-sm leading-relaxed">
        <li>
          Open the DMG and drag <strong>Ternline</strong> into <strong>Applications</strong>.
        </li>
        <li>
          Open Ternline from Applications. If a developer-verification warning appears, dismiss it.
        </li>
        <li>
          Open <strong>System Settings → Privacy &amp; Security</strong> and scroll down.
        </li>
        <li>
          Click <strong>Open Anyway</strong> for Ternline, then confirm <strong>Open</strong>.
        </li>
      </ol>
      <p class="mt-5 text-xs leading-relaxed text-muted">
        Approval happens in macOS after installation.{' '}
        <a
          href="https://support.apple.com/en-us/102445"
          class="text-accent underline underline-offset-4"
        >
          Read Apple's instructions
        </a>
      </p>
      <a
        id="macos-download"
        href={downloads['mac-arm64']}
        class="button mt-6 bg-accent text-[#15121e] hover:bg-[#c2b4ff]"
      >
        Download DMG <Icon name="download" class="size-4" />
      </a>
    </dialog>

    <script>
      import { latestPublishedRelease, recommendedDownload, releasesApi } from '../lib/downloads'

      const dialog = document.querySelector<HTMLDialogElement>('#workspace-screenshot')!
      const openButton = document.querySelector<HTMLButtonElement>('#open-screenshot')!

      openButton.addEventListener('click', () => dialog.showModal())

      const download = document.querySelector<HTMLAnchorElement>('#recommended-download')!
      const label = document.querySelector<HTMLElement>('#download-label')!
      const suggestion = document.querySelector<HTMLElement>('#download-suggestion')!
      const macosDialog = document.querySelector<HTMLDialogElement>('#macos-first-launch')!
      const macosDownload = document.querySelector<HTMLAnchorElement>('#macos-download')!

      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        '[data-download^="mac-"], #recommended-download'
      )) {
        link.addEventListener('click', (event) => {
          if (link === download && !download.hasAttribute('data-macos-download')) return
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
          event.preventDefault()
          macosDownload.href = link.href
          macosDialog.showModal()
        })
      }
      macosDownload.addEventListener('click', () => macosDialog.close())

      const hints = (
        navigator as Navigator & {
          userAgentData?: {
            platform: string
            getHighEntropyValues(
              values: string[]
            ): Promise<{ architecture?: string; bitness?: string }>
          }
        }
      ).userAgentData
      const browser = {
        platform: hints?.platform ?? navigator.platform,
        userAgent: navigator.userAgent,
        maxTouchPoints: navigator.maxTouchPoints
      }
      let cpu: { architecture?: string; bitness?: string } = {}
      function suggestDownload(architecture?: string, bitness?: string) {
        const recommendation = recommendedDownload({ ...browser, architecture, bitness })
        if (!recommendation) return
        const names = { mac: 'macOS', windows: 'Windows', linux: 'Linux' }
        const name = names[recommendation.os]
        const asset =
          recommendation.asset &&
          document.querySelector<HTMLAnchorElement>(`[data-download="${recommendation.asset}"]`)
        download.href = asset?.href ?? `#download-${recommendation.os}`
        download.toggleAttribute(
          'data-macos-download',
          recommendation.os === 'mac' && Boolean(asset)
        )
        label.textContent = asset ? `Download for ${name}` : `Choose your ${name} download`
        suggestion.textContent = `Suggested for your device: ${name}. All downloads are available below.`
        document
          .querySelector(`#download-${recommendation.os}`)
          ?.classList.replace('border-line', 'border-accent')
      }
      suggestDownload()
      if (hints) {
        void hints
          .getHighEntropyValues(['architecture', 'bitness'])
          .then((values) => {
            cpu = values
            suggestDownload(cpu.architecture, cpu.bitness)
          })
          .catch(() => {})
      }

      async function refreshDownloads() {
        try {
          const response = await fetch(releasesApi, {
            headers: { Accept: 'application/vnd.github+json' },
            cache: 'no-store',
            signal: AbortSignal.timeout(8000)
          })
          if (!response.ok) return
          const release = document.querySelector<HTMLAnchorElement>('#download-release')!
          const latest = latestPublishedRelease(await response.json(), release.dataset['version'])
          if (!latest) return
          for (const [asset, href] of Object.entries(latest.downloads)) {
            const link = document.querySelector<HTMLAnchorElement>(`[data-download="${asset}"]`)
            if (link) link.href = href
          }
          release.href = latest.url
          document
            .querySelector<HTMLAnchorElement>('[data-release-files]')
            ?.setAttribute('href', latest.url)
          release.textContent = `v${latest.version} · ${latest.prerelease ? 'Pre-release' : 'Release'}`
          release.dataset['version'] = latest.version
          const macAsset = macosDownload.href.includes('-macos-x64.dmg') ? 'mac-x64' : 'mac-arm64'
          macosDownload.href = latest.downloads[macAsset]
          suggestDownload(cpu.architecture, cpu.bitness)
        } catch {
          // The verified build-time downloads remain available when GitHub cannot be reached.
        }
      }
      void refreshDownloads()
    </script>
  </body>
</html>
